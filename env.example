# ================================
# PAYETONKAWA - CONFIGURATION GLOBALE
# ================================

# Copiez ce fichier vers .env et ajustez les valeurs selon votre environnement

# === API GATEWAY ===
API_GATEWAY_PORT=3000
JWT_SECRET=your-super-secret-jwt-key-here-change-in-production
JWT_EXPIRES_IN=1h

# === MICROSERVICES PORTS ===
CLIENTS_SERVICE_PORT=3001
PRODUCTS_SERVICE_PORT=3002
ORDERS_SERVICE_PORT=3003

# === BASE DE DONNÉES ===
# Service Clients
CLIENTS_DB_HOST=localhost
CLIENTS_DB_PORT=5433
CLIENTS_DB_NAME=payetonkawa_clients
CLIENTS_DB_USER=postgres
CLIENTS_DB_PASSWORD=your-secure-password

# Service Produits
PRODUCTS_DB_HOST=localhost
PRODUCTS_DB_PORT=5434
PRODUCTS_DB_NAME=payetonkawa_products
PRODUCTS_DB_USER=postgres
PRODUCTS_DB_PASSWORD=your-secure-password

# Service Commandes
ORDERS_DB_HOST=localhost
ORDERS_DB_PORT=5435
ORDERS_DB_NAME=payetonkawa_orders
ORDERS_DB_USER=postgres
ORDERS_DB_PASSWORD=your-secure-password

# === MESSAGE BROKER ===
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# === MONITORING ===
GRAFANA_PORT=3100
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

PROMETHEUS_PORT=9090

# === SÉCURITÉ ===
RATE_LIMIT_TTL=60000
RATE_LIMIT_MAX=60
CORS_ORIGIN=http://localhost:3000,http://localhost:3100

# === ENVIRONNEMENT ===
NODE_ENV=development
LOG_LEVEL=info 