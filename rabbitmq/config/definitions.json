{
  "rabbit_version": "3.12.0",
  "rabbitmq_version": "3.12.0",
  "product_name": "RabbitMQ",
  "product_version": "3.12.0",
  "users": [
    {
      "name": "payetonkawa",
      "password_hash": "ibuYiW4mOBPl7uGOUOqGjQsGlsNKIWOBYdqcDvJWKyFBJFPD",
      "hashing_algorithm": "rabbit_password_hashing_sha256",
      "tags": ["administrator", "management"]
    }
  ],
  "vhosts": [
    {
      "name": "/payetonkawa"
    }
  ],
  "permissions": [
    {
      "user": "payetonkawa",
      "vhost": "/payetonkawa",
      "configure": ".*",
      "write": ".*",
      "read": ".*"
    }
  ],
  "topic_permissions": [],
  "parameters": [],
  "global_parameters": [
    {
      "name": "cluster_name",
      "value": "payetonkawa-cluster"
    }
  ],
  "policies": [
    {
      "vhost": "/payetonkawa",
      "name": "ha-all",
      "pattern": ".*",
      "apply-to": "all",
      "definition": {
        "ha-mode": "all",
        "ha-sync-mode": "automatic"
      },
      "priority": 0
    }
  ],
  "exchanges": [
    {
      "name": "payetonkawa.events",
      "vhost": "/payetonkawa",
      "type": "topic",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    },
    {
      "name": "payetonkawa.dlx",
      "vhost": "/payetonkawa",
      "type": "direct",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    },
    {
      "name": "payetonkawa.retry",
      "vhost": "/payetonkawa",
      "type": "direct",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    }
  ],
  "queues": [
    {
      "name": "customer.events",
      "vhost": "/payetonkawa",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-dead-letter-exchange": "payetonkawa.dlx",
        "x-dead-letter-routing-key": "customer.dlq",
        "x-message-ttl": 3600000,
        "x-max-retries": 3
      }
    },
    {
      "name": "product.events",
      "vhost": "/payetonkawa",
